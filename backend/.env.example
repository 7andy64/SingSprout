DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/singsprout
# 安全密钥 — 生产环境必须设置强随机字符串
# 生成: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-string
# 逗号分隔的允许跨域来源。开发环境 DEBUG 模式允许所有来源。
CORS_ORIGINS=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=singsprout-audio
OSS_REGION=cn-hangzhou
# RAM 角色 ARN，用于 STS 临时凭证下发（客户端直传 OSS）
OSS_STS_ROLE_ARN=
SHARE_LINK_BASE_URL=https://singsprout.app/s
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 服务端 TTS（父母文字回信 → AI 朗读，异步任务模式）
DASHSCOPE_API_KEY=
TTS_MODEL=sambert-zhichu-v1
