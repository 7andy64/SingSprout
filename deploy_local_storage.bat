@echo off
chcp 65001 >nul
setlocal enabledelayedexpansion

:: 切换到 Flutter 项目目录
cd /d "%~dp0sing_sprout"

if not exist "lib\main.dart" (
  echo [错误] 未找到 sing_sprout\lib\main.dart，请确认脚本位于仓库根目录
  pause
  exit /b 1
)

echo ========================================
echo   声芽 SingSprout - 本地存储层部署脚本
echo ========================================
echo.
echo [1/3] 创建目录结构...

if not exist "lib" mkdir "lib"
if not exist "lib/features/humming_garden" mkdir "lib/features/humming_garden"
if not exist "lib/shared/models" mkdir "lib/shared/models"
if not exist "lib/shared/providers" mkdir "lib/shared/providers"
if not exist "lib/shared/repositories" mkdir "lib/shared/repositories"
if not exist "lib/shared/services" mkdir "lib/shared/services"

echo [2/3] 写入文件...

echo   pubspec.yaml
powershell -Command "[System.IO.File]::WriteAllBytes('pubspec.yaml', [System.Convert]::FromBase64String(''))"
if %errorlevel% neq 0 (
  echo   [错误] 写入 pubspec.yaml 失败！
  pause
  exit /b 1
)
echo   lib/main.dart
powershell -Command "[System.IO.File]::WriteAllBytes('lib/main.dart', [System.Convert]::FromBase64String(''))"
if %errorlevel% neq 0 (
  echo   [错误] 写入 lib/main.dart 失败！
  pause
  exit /b 1
)
echo   lib/shared/providers/app_state.dart
powershell -Command "[System.IO.File]::WriteAllBytes('lib/shared/providers/app_state.dart', [System.Convert]::FromBase64String(''))"
