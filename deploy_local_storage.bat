echo.
echo [3/3] 完成！
echo.
echo ========================================
echo   所有文件写入成功！（共 12 个文件）
echo ========================================
echo.
echo 请手动执行以下命令安装依赖：
echo   flutter pub get
echo.
pause
endlocal